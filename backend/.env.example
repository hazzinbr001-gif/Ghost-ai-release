# ── DeepSeek ──────────────────────────────────────────────────────────────────
# Get from: platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-...

# Model options:
#   deepseek-flash    → DeepSeek-V4.1-Flash  (fast, cheap, supports vision) ← recommended
#   deepseek-v4-pro   → DeepSeek-V4-Pro      (stronger reasoning, no vision)
AI_MODEL=deepseek-flash
AI_VISION_MODEL=deepseek-flash

# ── Supabase Postgres ─────────────────────────────────────────────────────────
# Get from: Supabase dashboard → Project Settings → Database → URI
# Use the "URI" tab — looks like: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SECRET=pick-a-long-random-string
RATE_LIMIT_PER_HOUR=60

# ── Download URLs (upload your built binaries and paste URLs here) ────────────
DOWNLOAD_URL_WINDOWS=https://github.com/hazzinbr001-gif/Ghost-ai-release/releases/download/v1.0/Ghost_AI-setup.exe
DOWNLOAD_URL_LINUX=https://github.com/hazzinbr001-gif/Ghost-ai-release/releases/download/v1.0/Ghost_AI-linux
DOWNLOAD_URL_MAC=https://github.com/hazzinbr001-gif/Ghost-ai-release/releases/download/v1.0/Ghost_AI-mac.zip
